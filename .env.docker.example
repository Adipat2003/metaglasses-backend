# Copy to .env.docker after starting the local Supabase Docker stack with `supabase start`.
# `host.docker.internal` reaches the Supabase ports published on the Docker host.
APP_ENV=local
AUTH_MODE=required
SUPABASE_URL=http://host.docker.internal:54321
# Local Supabase issues tokens for its host-facing API URL, not the Docker gateway URL.
SUPABASE_JWT_ISSUER=http://127.0.0.1:54321/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
CORS_ORIGINS=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@host.docker.internal:54322/postgres

# Keep real values outside source control.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
PAIRING_TTL_SECONDS=3600
