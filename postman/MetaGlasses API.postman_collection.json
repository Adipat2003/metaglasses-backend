{
  "info": {
    "name": "MetaGlasses API",
    "description": "Generated from the backend API routes. Select an example environment, duplicate it in Postman, then populate its publishable key and test-user credentials.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Supabase Auth",
      "item": [
        {
          "name": "Read enabled providers",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "apikey",
                "value": "{{supabase_publishable_key}}",
                "type": "text"
              }
            ],
            "url": "{{supabase_url}}/auth/v1/settings"
          }
        },
        {
          "name": "Sign up with email and password",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.access_token) pm.environment.set('access_token', body.access_token);",
                  "if (body.refresh_token) pm.environment.set('refresh_token', body.refresh_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "apikey",
                "value": "{{supabase_publishable_key}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{test_email}}\",\n  \"password\": \"{{test_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{supabase_url}}/auth/v1/signup"
          }
        },
        {
          "name": "Sign in and save bearer token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('An access token was returned', () => pm.expect(body.access_token).to.be.a('string').and.not.empty);",
                  "if (body.access_token) pm.environment.set('access_token', body.access_token);",
                  "if (body.refresh_token) pm.environment.set('refresh_token', body.refresh_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "apikey",
                "value": "{{supabase_publishable_key}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{test_email}}\",\n  \"password\": \"{{test_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{supabase_url}}/auth/v1/token?grant_type=password"
          }
        },
        {
          "name": "Get current user",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "apikey",
                "value": "{{supabase_publishable_key}}",
                "type": "text"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}",
                "type": "text"
              }
            ],
            "url": "{{supabase_url}}/auth/v1/user"
          }
        },
        {
          "name": "Start Google OAuth",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "apikey",
                "value": "{{supabase_publishable_key}}",
                "type": "text"
              }
            ],
            "url": "{{supabase_url}}/auth/v1/authorize?provider=google&redirect_to={{app_redirect_url}}"
          }
        },
        {
          "name": "Start Apple OAuth",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "apikey",
                "value": "{{supabase_publishable_key}}",
                "type": "text"
              }
            ],
            "url": "{{supabase_url}}/auth/v1/authorize?provider=apple&redirect_to={{app_redirect_url}}"
          }
        }
      ]
    },
    {
      "name": "FastAPI smoke flow",
      "description": "Run in order: health, state, upload, chat, display, then delete.",
      "item": [
        {
          "name": "Health check",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Environment matches the selected environment', () => {",
                  "  pm.expect(pm.response.json().environment).to.eql(pm.environment.get('app_env'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{backend_url}}/healthz"
          }
        },
        {
          "name": "Register pairing and set lens state",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pairingToken\": \"{{pairing_token}}\",\n  \"state\": \"listening\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{backend_url}}/v1/state",
            "description": "Run this before image upload or chat to register the pairing."
          }
        },
        {
          "name": "Upload pairing image",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('An image ID was returned', () => pm.expect(body.imageId).to.be.a('string').and.not.empty);",
                  "if (body.imageId) pm.environment.set('image_id', body.imageId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "image/jpeg",
                "type": "text"
              }
            ],
            "body": {
              "mode": "file",
              "file": {
                "src": ""
              }
            },
            "url": "{{backend_url}}/v1/images?pairingToken={{pairing_token}}",
            "description": "Select a JPEG file in Body. For PNG, change Content-Type to image/png."
          }
        },
        {
          "name": "Chat with uploaded image",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('A model response was returned', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.responseId).to.be.a('string').and.not.empty;",
                  "  pm.expect(body.text).to.be.a('string').and.not.empty;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pairingToken\": \"{{pairing_token}}\",\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"What am I looking at?\",\n      \"imageIds\": [\n        \"{{image_id}}\"\n      ]\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{backend_url}}/v1/chat",
            "description": "Upload an image first. The upload request saves image_id automatically."
          }
        },
        {
          "name": "Read paired lens display",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{backend_url}}/v1/display?token={{pairing_token}}",
            "description": "The pairing token is the lens capability credential. No bearer token is used."
          }
        },
        {
          "name": "Delete uploaded pairing image",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}",
                "type": "text"
              }
            ],
            "url": "{{backend_url}}/v1/images/{{image_id}}?pairingToken={{pairing_token}}"
          }
        }
      ]
    }
  ]
}
