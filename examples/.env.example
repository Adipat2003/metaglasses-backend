# Copy this file to the repository root as the desired .env.* file, then choose
# the values appropriate for the environment. Keep the copy and real secrets untracked.

# local, trial, or prod
APP_ENV=local

# Use disabled only with APP_ENV=local. Trial and prod must use required.
AUTH_MODE=disabled

# Required when AUTH_MODE=required. Hosted environments must use HTTPS.
SUPABASE_URL=
SUPABASE_JWT_AUDIENCE=authenticated

# Use * only for local development. Hosted environments require explicit origins.
CORS_ORIGINS=*

NVIDIA_API_KEY=
NVIDIA_MODEL=moonshotai/kimi-k3
PAIRING_TTL_SECONDS=3600
