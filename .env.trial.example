APP_ENV=trial
AUTH_MODE=required
SUPABASE_URL=https://TRIAL_PROJECT_REF.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated
CORS_ORIGINS=https://trial.glance.example
DATABASE_URL=postgresql://postgres.TRIAL_PROJECT_REF:<PERCENT_ENCODED_PASSWORD>@<SESSION_POOLER_HOST>:5432/postgres?sslmode=require

# Keep real values outside source control.
OPENAI_API_KEY=
