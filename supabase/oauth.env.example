# Copy this file to supabase/oauth.env and replace every placeholder locally.
# Never commit the populated file.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=<GOOGLE_WEB_CLIENT_ID>
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=<GOOGLE_WEB_CLIENT_SECRET>
SUPABASE_AUTH_EXTERNAL_APPLE_CLIENT_ID=<APPLE_SERVICES_ID>
SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=<APPLE_GENERATED_CLIENT_SECRET>
SUPABASE_AUTH_EXTERNAL_APPLE_REDIRECT_URI=<PUBLIC_HTTPS_TUNNEL>/auth/v1/callback
