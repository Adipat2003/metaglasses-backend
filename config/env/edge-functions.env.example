# AWS API runtime configuration. Put NVIDIA_API_KEY in Secrets Manager, not this file.
APP_ENV=aws
AWS_REGION=us-east-1
COGNITO_USER_POOL_ID=<COGNITO_USER_POOL_ID>
COGNITO_APP_CLIENT_ID=<COGNITO_APP_CLIENT_ID>
DATABASE_HOST=<DATABASE_HOST>
DATABASE_PORT=5432
DATABASE_NAME=metaglasses
PAIRING_IMAGE_BUCKET=<PAIRING_IMAGE_BUCKET>
NVIDIA_SECRET_ARN=<NVIDIA_SECRET_ARN>
NVIDIA_MODEL=meta/llama-3.2-90b-vision-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
